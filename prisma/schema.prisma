generator client {

  provider = "prisma-client-js"
}

datasource db {

  provider = "postgresql"

  url = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum PlatformRole {

  MEMBER
  PREMIUM
  FLEET
  ADMIN
}

enum SubscriptionStatus {

  ACTIVE
  TRIAL
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum TelemetrySeverity {

  INFO
  WARNING
  CRITICAL
}

enum TelemetryCategory {

  FEDERATION
  EXPEDITION
  MAINTENANCE
  READINESS
  FLEET
}

enum SupplierHealth {

  HEALTHY
  DEGRADED
  OFFLINE
}

// ============================================================
// USERS
// ============================================================

model User {

  id String @id @default(cuid())

  email String @unique

  name String

  passwordHash String?

  role PlatformRole @default(MEMBER)

  active Boolean @default(true)

  fleetId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================================
  // RELATIONS
  // ==========================================================

  subscription Subscription?

  vehicles Vehicle[]

  telemetryEvents OperationalTelemetry[]

  procurementHistory ProcurementTelemetry[]

  expeditionAssessments ExpeditionAssessment[]

  fleet Fleet? @relation(fields: [fleetId], references: [id])
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {

  id String @id @default(cuid())

  userId String @unique

  stripeCustomerId String?

  stripeSubscriptionId String?

  status SubscriptionStatus

  planName String

  startedAt DateTime

  expiresAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================================
  // RELATIONS
  // ==========================================================

  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// VEHICLES
// ============================================================

model Vehicle {

  id String @id @default(cuid())

  userId String

  vin String @unique

  nickname String?

  model String

  engine String

  year Int

  readinessScore Int @default(0)

  survivabilityScore Int @default(0)

  maintenanceRisk Int @default(0)

  expeditionScore Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================================
  // RELATIONS
  // ==========================================================

  user User @relation(fields: [userId], references: [id])

  readinessHistory OperationalReadiness[]

  maintenanceEvents MaintenanceEvent[]

  procurementTelemetry ProcurementTelemetry[]
}

// ============================================================
// FLEETS
// ============================================================

model Fleet {

  id String @id @default(cuid())

  name String

  organisationName String

  readinessScore Int @default(0)

  survivabilityScore Int @default(0)

  deploymentConfidence Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================================
  // RELATIONS
  // ==========================================================

  users User[]

  telemetry FleetTelemetry[]
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {

  id String @id @default(cuid())

  supplierId String @unique

  name String

  country String

  website String?

  health SupplierHealth

  averageLatencyMs Int

  reliabilityScore Int

  leadTimeDays Int

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================================
  // RELATIONS
  // ==========================================================

  procurementTelemetry ProcurementTelemetry[]
}

// ============================================================
// PROCUREMENT
// ============================================================

model ProcurementTelemetry {

  id String @id @default(cuid())

  userId String?

  vehicleId String?

  supplierId String

  partNumber String

  description String

  price Float

  latencyMs Int

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONS
  // ==========================================================

  user User? @relation(fields: [userId], references: [id])

vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  supplier Supplier @relation(fields: [supplierId],references: [id])
}

// ============================================================
// TELEMETRY
// ============================================================

model OperationalTelemetry {

  id String @id @default(cuid())

  userId String?

  category TelemetryCategory

  severity TelemetrySeverity

  message String

  metadata Json?

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONS
  // ==========================================================

  user User? @relation(fields: [userId], references: [id])
}

// ============================================================
// READINESS
// ============================================================

model OperationalReadiness {

  id String @id @default(cuid())

  vehicleId String

  readinessScore Int

  survivabilityScore Int

  maintenanceRisk Int

  expeditionConfidence Int

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONS
  // ==========================================================

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ============================================================
// EXPEDITION
// ============================================================

model ExpeditionAssessment {

  id String @id @default(cuid())

  userId String

  vin String

  region String

  survivabilityScore Int

  deploymentConfidence Int

  logisticsRisk Int

  notes String?

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONS
  // ==========================================================

  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// FLEET TELEMETRY
// ============================================================

model FleetTelemetry {

  id String @id @default(cuid())

  fleetId String

  readinessScore Int

  survivabilityScore Int

  deploymentConfidence Int

  operationalAvailability Int

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONS
  // ==========================================================

  fleet Fleet @relation(fields: [fleetId], references: [id])
}

// ============================================================
// MAINTENANCE
// ============================================================

model MaintenanceEvent {

  id String @id @default(cuid())

  vehicleId String

  title String

  description String?

  mileage Int?

  serviceDate DateTime

  critical Boolean @default(false)

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONS
  // ==========================================================

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}